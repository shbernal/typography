{
  "name": "@shbernal/typography",
  "version": "0.3.0",
  "description": "Orthotypography rules for English, French, Spanish, German and Dutch as data: check text against a cited convention, or fix the subset that is safe to fix unattended.",
  "keywords": [
    "typography",
    "orthotypography",
    "english",
    "french",
    "spanish",
    "german",
    "dutch",
    "imprimerie-nationale",
    "chicago-manual-of-style",
    "rae",
    "duden",
    "taalunie",
    "guillemets",
    "no-break-space",
    "i18n",
    "l10n",
    "linter"
  ],
  "author": "shbernal",
  "license": "MIT",
  "homepage": "https://github.com/shbernal/typography#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/typography.git"
  },
  "bugs": {
    "url": "https://github.com/shbernal/typography/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "typocheck": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "docs",
    ".claude-plugin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fr": {
      "types": "./dist/styles/fr.d.ts",
      "import": "./dist/styles/fr.js"
    },
    "./en": {
      "types": "./dist/styles/en.d.ts",
      "import": "./dist/styles/en.js"
    },
    "./es": {
      "types": "./dist/styles/es.d.ts",
      "import": "./dist/styles/es.js"
    },
    "./de-DE": {
      "types": "./dist/styles/de-DE.d.ts",
      "import": "./dist/styles/de-DE.js"
    },
    "./de-CH": {
      "types": "./dist/styles/de-CH.d.ts",
      "import": "./dist/styles/de-CH.js"
    },
    "./nl": {
      "types": "./dist/styles/nl.d.ts",
      "import": "./dist/styles/nl.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js"
    }
  },
  "scripts": {
    "clean": "node --eval \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepare": "node scripts/install-hooks.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src test scripts charcheck.config.ts && pnpm run lint:chars",
    "lint:chars": "charcheck",
    "lint:fix": "biome check --write src test scripts charcheck.config.ts",
    "format": "biome format --write src test scripts charcheck.config.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "battery": "node scripts/battery.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "charcheck": "^0.2.5",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  }
}
