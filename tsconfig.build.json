{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    // Both maps resolve `sources` to `../src/*.ts`, so `src` is in package.json's
    // `files`. Shipping a map whose sources are not in the tarball is a dangling
    // reference that costs a consumer go-to-definition and gains nothing. The
    // source is also where this package explains itself, which makes it worth the
    // few kilobytes; `exports` names only `dist`, so nothing can import it by
    // accident.
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",

    // `allowImportingTsExtensions` is a typecheck-only affordance and is refused
    // once emit is on. `rewriteRelativeImportExtensions` is its emitting
    // counterpart: `.ts` specifiers stay in the source, so the tree keeps running
    // directly under Node's type stripping, and the emitted JS says `.js`.
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
